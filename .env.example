# ==============================================================================
# Renuka Art Studio (webrenuka) - Production Environment Variables Template
# ==============================================================================
# NOTE: Never commit production credentials, tokens, or private keys to git.
# Add actual values in Vercel Project Settings -> Environment Variables.
# ==============================================================================

# Supabase Public Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Server-Only Secret (Never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Base Site URL
NEXT_PUBLIC_SITE_URL=

# Razorpay Payment Gateway (Server-only secrets kept private)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend / Email Provider
RESEND_API_KEY=
EMAIL_FROM=

# WhatsApp Business API (Meta Cloud API)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
